    "framer-motion": "^13.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.5",
    "ogl": "^1.0.11",
    "parse5": "^7.3.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.2",
    "three": "^0.186.0",
    "zod": "^4.6.5"
