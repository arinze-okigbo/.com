    "jsdom": "^25.0.1",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.0.8"
